# Public frontend env only - never put JWT secrets, Supabase service role,
# SMS API tokens, or other backend credentials here.

# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:5000

# This Next.js app URL (used for metadata, sitemap, OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

