# Public frontend env only - never put JWT secrets, Supabase service role,
# SMS API tokens, or other backend credentials here.

# Backend API base URL (no trailing slash) - always set in this file / deploy env.
# Local: http://localhost:5000
# Production: https://api.gasnationweed.com
NEXT_PUBLIC_API_URL=https://api.gasnationweed.com

# This Next.js app URL (metadata, sitemap, OAuth redirects, Open Graph).
# Defaults to https://gasnationweed.com if unset or set to localhost.
NEXT_PUBLIC_APP_URL=https://gasnationweed.com

