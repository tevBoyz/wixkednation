PORT=5000
NODE_ENV=development

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,https://www.gasnationweed.com
# Public origin browsers use to reach this API. Product image URLs are built
# from it, so in production set the real domain (e.g. https://api.example.com).
BACKEND_URL=http://localhost:5000

DATABASE_URL=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=

# SMS: AdminSettings.provider wins; SMS_PROVIDER is fallback only when DB unset.
# Allowed values: mock | twilio (AfroMessage is retired / not callable).
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Email (Google Workspace SMTP). Use mock locally; smtp + App Password in prod.
# App Password for noreply@ goes in SMTP_PASS (spaces optional).
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@gasnationweed.com
SMTP_PASS=
EMAIL_FROM="GasNation <noreply@gasnationweed.com>"
# Public HTTPS logo for email clients (never use localhost)
EMAIL_LOGO_URL=https://gasnationweed.com/brand/gasnation-logo-full.png
# Optional: public site URL used in email links (admin/order). Falls back to FRONTEND_URL, then https://gasnationweed.com (never localhost).
EMAIL_APP_URL=https://gasnationweed.com
ADMIN_ORDER_NOTIFICATION_EMAILS=orders@gasnationweed.com
SYSTEM_ALERT_EMAILS=info@gasnationweed.com
# Shown on Delivered customer emails; leave blank until ready
GOOGLE_REVIEW_URL=

OTP_EXPIRES_MINUTES=5
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

INTERNAL_API_KEY=

# Analytics: salt for hashing visitor IPs (never store raw IP)
ANALYTICS_IP_SALT=

# Seed users (npm run seed)
SEED_ADMIN_EMAIL=admin@gasnation.com
SEED_ADMIN_PIN=072326
SEED_SUPERADMIN_PIN=199183
SEED_SUPERADMIN1_EMAIL=superadmin1@gasnationweed.com
SEED_SUPERADMIN2_EMAIL=superadmin2@gasnationweed.com

# Legacy compatibility placeholders while auth migration is in progress.
JWT_SECRET=
SESSION_SECRET=
